{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm test*)",
      "Bash(npm run generate*)",
      "Bash(npm view *)",
      "Bash(npm audit)",
      "Bash(npm ls*)",
      "Bash(npm --version)",
      "Bash(node --version)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prettier --check *)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate*)",
      "Bash(git status)",
      "Bash(git status*)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)",
      "Bash(git remote -v)",
      "Bash(git worktree list*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(git stash list)",
      "Bash(git fetch*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up -d*)",
      "Bash(docker ps*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -i http://localhost:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./apps/*/.env)",
      "Read(./apps/*/.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(*prisma migrate reset*)"
    ],
    "ask": ["Bash(git push *)", "Bash(npm run migrate*)", "Bash(npm install *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx prettier --write \"$CLAUDE_FILE_PATHS\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
