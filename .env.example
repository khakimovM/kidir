# Kidir — environment template.
# Copy to .env in the repo root and fill in. Never commit .env.
# Every key here is validated by apps/api/src/config/env.ts (zod) at boot.

NODE_ENV=development

# --- Infrastructure -------------------------------------------------------
# Port 5433 on the host: docker-compose maps postgres 5432 -> 5433 so it does
# not clash with a native Postgres install.
DATABASE_URL=postgresql://kidir:kidir@localhost:5433/kidir?schema=public
REDIS_URL=redis://localhost:6379

# --- Apps -----------------------------------------------------------------
API_PORT=4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Auth -----------------------------------------------------------------
# Minimum 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-48-byte-secret-value
JWT_REFRESH_SECRET=change-me-to-a-different-random-48-byte-secret
COOKIE_DOMAIN=localhost

# --- Providers ------------------------------------------------------------
# mock: no external account needed, the OTP code is written to the app log.
SMS_PROVIDER=mock
MAIL_PROVIDER=mock

# Required only when SMS_PROVIDER=eskiz (see docs/SETUP.md).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# Required only when MAIL_PROVIDER=gmail (see docs/SETUP.md).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kidir <no-reply@kidir.net>

# --- Google OAuth (client sign-in) ----------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
